model NextStep {
  id           String   @id @default(uuid())
  stepNumber   Int      @unique
  title        String
  description  String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([stepNumber])
  @@index([isActive])
  @@index([displayOrder])
  @@map("next_steps")
}
