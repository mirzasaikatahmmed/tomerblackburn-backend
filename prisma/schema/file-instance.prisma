model FileInstance {
  id String @id @default(uuid())

  filename         String
  originalFilename String
  path             String
  url              String
  fileType         FileType @default(any)
  mimeType         String
  size             Int

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  homeBackgroundImage     HomePage[]
  serviceImages           ServiceStandsOut[]
  aboutUsImages           AboutUs[]
  portfolioImages         Portfolio[]
  portfolioCategoryImages PortfolioImage[]
  siteSettingsLogos       SiteSettings[]
  services                Service[]            @relation("ServiceImage")
  submissionMedia         SubmissionMedia[]
  contactMedia            ContactMedia[]       @relation("ContactMediaFileInstance")
  userAvatars             User[]               @relation("UserAvatar")
  estimatorBackgrounds    EstimatorPage[]      @relation("EstimatorBackground")
  whyChooseUsIcons        WhyChooseUsFeature[] @relation("WhyChooseUsIcon")
  projectTypes            ProjectType[]
  serviceCategories       ServiceCategory[]

  @@map("file_instances")
}

enum FileType {
  image
  docs
  link
  document
  any
  video
  audio
}
