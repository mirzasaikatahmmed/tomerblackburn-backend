model CostCode {
  id          String   @id @default(uuid())
  categoryId  String
  serviceId   String?
  code        String   @unique
  name        String
  elies       String? // Alternative/alias name for the cost code
  tips        String[] @default([]) // Tips (array format)
  description String?

  basePrice   Decimal  @default(0) @db.Decimal(10, 2)
  markup      Decimal  @default(0) @db.Decimal(5, 2)
  clientPrice Decimal  @default(0) @db.Decimal(10, 2)
  unitType    UnitType @default(FIXED)

  questionType QuestionType @default(WHITE)

  step              Int     @default(1)
  displayOrder      Int     @default(0)
  isIncludedInBase  Boolean @default(false)
  requiresQuantity  Boolean @default(false)
  isOptional        Boolean @default(false)
  isActive          Boolean @default(true)
  excludeFromExport Boolean @default(false) // Branch-only: show in estimator, do not export to Buildertrend

  parentCostCodeId    String? // Parent question ID
  showWhenParentValue String? // Condition: "true", "false", "optionId", "ANY"
  nestedInputType     String? // "QUANTITY", "DROPDOWN", "CUSTOM_PRICE", "NONE"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category         CostCodeCategory  @relation(fields: [categoryId], references: [id])
  service          Service?          @relation(fields: [serviceId], references: [id])
  options          CostCodeOption[]
  serviceCostCodes ServiceCostCode[]
  submissionItems  SubmissionItem[]

  parentCostCode CostCode?  @relation("NestedQuestions", fields: [parentCostCodeId], references: [id])
  childCostCodes CostCode[] @relation("NestedQuestions")

  @@index([code])
  @@index([categoryId])
  @@index([serviceId])
  @@index([isActive])
  @@index([questionType])
  @@index([displayOrder])
  @@index([step])
  @@map("cost_codes")
}

// Question Type determines UI behavior (color-coded in admin)
enum QuestionType {
  WHITE // Fixed/Included in base price - no user interaction, just informational
  BLUE // Toggle - on/off switch, adds fixed price when enabled
  GREEN // Dropdown selection - user picks from options (per upgrade)
  ORANGE // Dropdown with tiers - Standard/Mid-Range/Premium options
  YELLOW // User input - numeric input (e.g., square footage)
  RED // User input variant
  PURPLE // User input variant
}

// How the cost is calculated
enum UnitType {
  FIXED // Fixed one-time cost
  PER_SQFT // Price per square foot
  PER_EACH // Price per unit/item
  PER_LOT // Price per lot
  PER_SET // Price per set
  PER_UPGRADE // Price per upgrade selection
}
