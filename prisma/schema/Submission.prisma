model Submission {
  id               String @id @default(uuid())
  submissionNumber String @unique // EST-2026-001

  serviceId String

  clientName       String
  clientEmail      String
  clientPhone      String
  projectAddress   String
  zipCode          String?
  desiredStartDate DateTime?
  buildingType     String?
  buildingTypeId   String?

  basePrice            Decimal @db.Decimal(10, 2)
  markup               Decimal @default(0) @db.Decimal(5, 2)
  clientPrice          Decimal @default(0) @db.Decimal(10, 2)
  additionalItemsTotal Decimal @default(0) @db.Decimal(10, 2)
  totalAmount          Decimal @db.Decimal(10, 2)

  status     SubmissionStatus @default(PENDING)
  isArchived Boolean          @default(false)

  projectNotes      String?
  additionalDetails String?

  pdfUrl String?

  ipAddress   String?
  userAgent   String?
  submittedAt DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  reviewedAt  DateTime?
  completedAt DateTime?

  service                 Service                            @relation(fields: [serviceId], references: [id])
  buildingTypeRef         BuildingType?                      @relation(fields: [buildingTypeId], references: [id])
  submissionItems         SubmissionItem[]
  submissionMedia         SubmissionMedia[]
  emailLogs               EmailLog[]
  buildingTypeFieldValues SubmissionBuildingTypeFieldValue[]

  @@index([submissionNumber])
  @@index([status])
  @@index([clientEmail])
  @@index([clientPhone])
  @@index([submittedAt])
  @@index([serviceId])
  @@index([buildingTypeId])
  @@index([isArchived])
  @@map("submissions")
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model SubmissionItem {
  id               String  @id @default(uuid())
  submissionId     String
  costCodeId       String
  selectedOptionId String?

  quantity   Decimal @default(1) @db.Decimal(10, 2)
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  questionType   QuestionType?
  isEnabled      Boolean       @default(true)
  userInputValue String?

  itemName           String?
  itemDescription    String?
  selectedOptionName String?

  notes     String?
  createdAt DateTime @default(now())

  submission     Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  costCode       CostCode        @relation(fields: [costCodeId], references: [id])
  selectedOption CostCodeOption? @relation(fields: [selectedOptionId], references: [id])

  @@index([submissionId])
  @@index([costCodeId])
  @@index([selectedOptionId])
  @@map("submission_items")
}

model SubmissionMedia {
  id             String @id @default(uuid())
  submissionId   String
  fileInstanceId String

  mediaType    MediaType @default(PHOTO)
  description  String?
  displayOrder Int       @default(0)
  uploadedAt   DateTime  @default(now())

  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  fileInstance FileInstance @relation(fields: [fileInstanceId], references: [id])

  @@index([submissionId])
  @@index([mediaType])
  @@index([fileInstanceId])
  @@map("submission_media")
}

enum MediaType {
  PHOTO
  VIDEO
}

model SubmissionBuildingTypeFieldValue {
  id           String @id @default(uuid())
  submissionId String
  fieldId      String

  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submission Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  field      BuildingTypeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([submissionId, fieldId])
  @@index([submissionId])
  @@index([fieldId])
  @@map("submission_building_type_field_values")
}
