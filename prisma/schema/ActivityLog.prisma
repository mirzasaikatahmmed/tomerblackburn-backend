model ActivityLog {
  id          String   @id @default(uuid())
  action      String // create, update, delete, view, status_change
  entityType  String // submission, bathroom_type, cost_code, settings
  entityId    String?
  description String?
  metadata    String? // JSON data
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
  @@index([action])
  @@index([isRead])
  @@map("activity_logs")
}
